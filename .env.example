# PostgreSQL connection string (Phase 0)
# Example: postgresql://user:password@host:5432/astahub
DATABASE_URL=

# Auth.js — generate a strong random secret, e.g. via: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Piston API token for real C/ASM code execution
# Request a token: https://discord.gg/engineerman (educational use only)
# Without a token, code runs in simulated mode
PISTON_AUTH_TOKEN=
