# PostgreSQL connection string (Phase 0)
# Example: postgresql://user:password@host:5432/astahub
DATABASE_URL=

# Auth — generate a strong random secret, e.g. via: openssl rand -base64 32
# Express JWT uses JWT_SECRET (NEXTAUTH_SECRET kept as fallback for compat)
JWT_SECRET=
NEXTAUTH_SECRET= # optional fallback to JWT_SECRET
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development

# Google OAuth — for "Continue with Google" sign-up/sign-in
# Create at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, Web application)
# Authorized redirect URI must be: http://localhost:4000/api/auth/google/callback (dev) or https://yourdomain/api/auth/google/callback (prod, via Vite proxy)
# The Vite dev server proxies /api → :4000, so the browser can also use http://localhost:3000/api/auth/google/callback — set GOOGLE_REDIRECT_URI to match what you register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Piston API — self-hosted when possible (public emkc.org is 401 since 2026-02-15)
# Point PISTON_API_URL to your self-hosted instance, e.g. https://piston.yourdomain/api/v2/piston
PISTON_API_URL=https://emkc.org/api/v2/piston
PISTON_AUTH_TOKEN=

# Upstash Redis — optional distributed rate limiting (multi-instance)
# When set, rate limits use Redis INCR+EXPIRE; otherwise in-memory fallback
# Create at https://upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Community (Phase 2) ─────────────────────────────────────────────
# Comma-separated emails of moderators who can see and action the
# moderation queue (/community/moderation).
# Example: MODERATOR_EMAILS=ada@example.com,grace@example.com
MODERATOR_EMAILS=

# Supabase Realtime — enables live group chat, presence, and live activity.
# Requires a Supabase project whose Postgres also hosts this app's schema
# (logical replication publishes new rows). When unset, community features
# degrade gracefully to polling — never a fake "live" state.
# After pointing DATABASE_URL at your Supabase Postgres, run:
#   ALTER PUBLICATION supabase_realtime ADD TABLE "Post", "Comment", "Vote", "Answer", "Message", "LiveEventMessage";
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Live (Phase 3) ──────────────────────────────────────────────────
# Moderators schedule live events (/live). MODERATOR_EMAILS (above) gates
# creating/editing events and the moderation queue.
#
# YouTube export — direct publishing of recordings with lesson-linked
# metadata via the YouTube Data API v3. Requires a Google Cloud project with
# the YouTube Data API enabled + an OAuth client (installed app) and a
# refresh token for the target channel. Until these are set, the export
# action returns an honest "not configured" message — never a fake success.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# ─── Recording pipeline — Cloudflare R2 / Stream (Phase 3) ──────────
# Stores raw recordings before YouTube export (S3-compatible, zero egress).
# Until these are set, recording uploads return an honest NOT_CONFIGURED
# result — never a fake success. Create a bucket at https://dash.cloudflare.com
# (R2) and a Stream API token for video transcoding.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# CLOUDFLARE_STREAM_TOKEN=

# ─── WebRTC P2P live coding — signaling + TURN/STUN (Phase 3) ──────
# Enables browser-to-browser live coding (video + shared editor). Requires
# a signaling server (e.g. Socket.io) and/or a TURN server for NAT traversal.
# Until these are set, P2P session creation returns honest NOT_CONFIGURED.
# SIGNALING_URL=
# NEXT_PUBLIC_SIGNALING_URL=
# TURN_URL=
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ─── Certificates — verification portal ────────────────────────────
# Public base URL for shareable certificate verification. When set, each
# certificate's verification link resolves to a public page that looks up
# the certificate by id. Until configured, the certificates page shows an
# honest "Verification requires public link — coming with portal" message
# and never fakes verification.
# Example: CERTIFICATE_VERIFY_URL=https://astahub.dev/certificates
# CERTIFICATE_VERIFY_URL=
# VITE_CERTIFICATE_VERIFY_URL= # same as above, exposed to the Vite client when set

# ─── AI Companion (Phase 4) ──────────────────────────────────────────
# OpenRouter API key powers the in-lesson AI coach (hint ladder + concept
# questions). Get one at https://openrouter.ai. Until this is set, the coach
# returns an honest "not configured" message — never a fake AI answer.
OPENROUTER_API_KEY=
# Model id for the coach. Defaults to openai/gpt-4o-mini (cheap + capable).
AI_MODEL=

# ─── Rainchecks + Adaptive Review (Phase 4 slice 2) ───────────────────
# No new env required. Rainchecks are local-first, pure spaced-repetition:
# - Raincheck prompts: low-pressure "Are you still engaged? Rate 1-5,
#   what blocked you?" checks. Shown every 7 days or after 3 days of
#   inactivity (only once you have 3+ completed days). Responses are
#   stored next to progress (e.g. localStorage / rainchecks array) —
#   no penalty, no grade, honest self-correction only. See src/lib/raincheck.ts
#   (`shouldShowRaincheck`, `nextRaincheckDay`, `recordRaincheckResponse`).
# - Adaptive review: resurfaces missed exercises at 1/3/7/14/30-day
#   intervals from `completedExercises` vs expected total. Pure helpers
#   in src/lib/adaptiveReview.ts (`reviewSchedule`, `nextReviewDate`) and
#   src/lib/raincheck.ts (`adaptiveReviewQueue`). No AI, no extra keys.
