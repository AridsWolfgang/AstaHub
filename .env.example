# PostgreSQL connection string (Phase 0)
# Example: postgresql://user:password@host:5432/astahub
DATABASE_URL=

# Auth — generate a strong random secret, e.g. via: openssl rand -base64 32
# Express JWT uses JWT_SECRET (fallback to NEXTAUTH_SECRET for compat)
JWT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — for "Continue with Google" sign-up/sign-in
# Create at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, Web application)
# Authorized redirect URI must be: http://localhost:4000/api/auth/google/callback (dev) or https://yourdomain/api/auth/google/callback (prod, via Vite proxy)
# The Vite dev server proxies /api → :4000, so the browser can also use http://localhost:3000/api/auth/google/callback — set GOOGLE_REDIRECT_URI to match what you register.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Piston API token for real C/ASM code execution
# Request a token: https://discord.gg/engineerman (educational use only)
# Without a token, code runs in simulated mode
PISTON_AUTH_TOKEN=

# ─── Community (Phase 2) ─────────────────────────────────────────────
# Comma-separated emails of moderators who can see and action the
# moderation queue (/community/moderation).
# Example: MODERATOR_EMAILS=ada@example.com,grace@example.com
MODERATOR_EMAILS=

# Supabase Realtime — enables live group chat, presence, and live activity.
# Requires a Supabase project whose Postgres also hosts this app's schema
# (logical replication publishes new rows). When unset, community features
# degrade gracefully to polling — never a fake "live" state.
# After pointing DATABASE_URL at your Supabase Postgres, run:
#   ALTER PUBLICATION supabase_realtime ADD TABLE "Post", "Comment", "Vote", "Answer", "Message", "LiveEventMessage";
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Live (Phase 3) ──────────────────────────────────────────────────
# Moderators schedule live events (/live). MODERATOR_EMAILS (above) gates
# creating/editing events and the moderation queue.
#
# YouTube export — direct publishing of recordings with lesson-linked
# metadata via the YouTube Data API v3. Requires a Google Cloud project with
# the YouTube Data API enabled + an OAuth client (installed app) and a
# refresh token for the target channel. Until these are set, the export
# action returns an honest "not configured" message — never a fake success.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# ─── AI Companion (Phase 4) ──────────────────────────────────────────
# OpenRouter API key powers the in-lesson AI coach (hint ladder + concept
# questions). Get one at https://openrouter.ai. Until this is set, the coach
# returns an honest "not configured" message — never a fake AI answer.
OPENROUTER_API_KEY=
# Model id for the coach. Defaults to openai/gpt-4o-mini (cheap + capable).
AI_MODEL=
